{
  "AllowedHosts": "kanchiwiremesh-api.runasp.net",
  "ConnectionStrings": {
    "SqlServer": "REPLACE_WITH_MONSTERASP_SQL_CONNECTION_STRING"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "kanchiwiremesh-api",
      "Audience": "kanchiwiremesh-clients",
      "SigningKey": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
      "AccessTokenLifetimeMinutes": 60
    }
  },
  "Cors": {
    "AllowLoopbackOrigins": false,
    "AllowedOrigins": [
      "https://www.example.com"
    ]
  }
}
